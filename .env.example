# Citely Deal Desk —— 环境变量模板
#
# 用法：cp .env.example .env 后填值。`.env` 已 gitignore，永不入库。
# 纪律：六类密钥物理分离，互不共享、互不派生。
#   1) 运营钱包   OPERATOR_PRIVATE_KEY        —— 8183 provider：setBudget / submit
#   2) 验证器     VERIFIER_PRIVATE_KEY        —— 8183 evaluator：complete / reject
#                                                （独立进程持有；也是 SA 的 EIP-712 签名者）
#   3) 客户钱包   MARKETPLACE_PRIVATE_KEY     —— 8183 client：createJob / approve+fund / claimRefund
#                                                （L4 演示 agent 持有，模拟客户侧）
#   4) 采购钱包   PROCUREMENT_PRIVATE_KEY     —— 链下 x402 付款，不参与 8183
#                                                （per-case，需提前 Gateway 预存）
#   5) Module 认证 MODULE_ATTESTER_PRIVATE_KEY —— 离线签 Module 版本认证清单的演示密钥
#                                                （只用于 scripts 离线签名，运行时进程不持有）
#   6) OpenAI     OPENAI_API_KEY              —— 判定器；该进程不持有任何链上私钥
# 角色映射详见 docs/design/contracts-vertical-slice.md §2.1。
# 只用 testnet，无真实资金。

# ── Arc Testnet ────────────────────────────────────────────────────────────
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
# 公共 RPC 易限流，失败时自动切换到备用
ARC_RPC_URL_FALLBACK=https://arc-testnet.drpc.org

# 链上密钥（0x 开头的 32 字节十六进制）
OPERATOR_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=
MARKETPLACE_PRIVATE_KEY=
PROCUREMENT_PRIVATE_KEY=

# 离线签名用，不进运行时进程
MODULE_ATTESTER_PRIVATE_KEY=

# ERC-8183 参考合约地址（spike ① 确认可用/部署后回填）
JOB_CONTRACT_ADDRESS=
# Arc Testnet USDC（8183 的 paymentToken，fund 前 approve 用）
USDC_ADDRESS=
# Circle Gateway Wallet（EIP-3009 的 verifyingContract，不是 USDC 合约）
GATEWAY_WALLET_ADDRESS=0x0077777d7eba4688bdef3e311b846f25870a19b9

# 轮询不订阅：链上状态轮询间隔
CHAIN_POLL_INTERVAL_MS=5000

# ── L1 Module 服务（msb-agent，已上线，只消费）─────────────────────────────
MSB_AGENT_BASE_URL=https://msb-agent-production-769d.up.railway.app
X402_FACILITATOR_URL=https://gateway-api-testnet.circle.com/v1/x402

# ── 判定器 LLM（设计见 docs/design/llm-provider-openai.md §5）──────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=
# 留空使用 SDK 默认端点
OPENAI_BASE_URL=
# 必须是带日期的 snapshot ID，不许用别名（别名漂移 = golden cache 静默失效）。
# 由 spike ⑨ 调 GET /v1/models 取回后写死到此处。
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=none
OPENAI_TEMPERATURE=0

# cache_first | cache_only | live；演示脚本固定用 cache_only
ADJUDICATOR_MODE=cache_first
ADJUDICATOR_TIMEOUT_MS=30000
ADJUDICATOR_MAX_CONCURRENCY=2
GOLDEN_DIR=demo/golden/adjudication
# 1 = golden 文件存材料明文（仅限已审阅的合成案件，会入 git 并被录屏）
GOLDEN_STORE_PLAINTEXT=0

# ── 本地状态（唯一真相源）──────────────────────────────────────────────────
DB_PATH=./data/deal-desk.sqlite
