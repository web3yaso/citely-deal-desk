    ".": "./src/index.ts",
    "./adjudicator": "./src/adjudicator/index.ts",
    "./orchestrator": "./src/orchestrator/index.ts",
    "./sandbox": "./src/sandbox/index.ts",
    "./policy": "./src/policy/index.ts",
