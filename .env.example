# Citely Deal Desk —— 环境变量模板
#
# 用法：cp .env.example .env 后填值。`.env` 已 gitignore，永不入库。
# 纪律：六类密钥物理分离，互不共享、互不派生。
#   1) 运营钱包   OPERATOR_PRIVATE_KEY        —— 8183 provider：setBudget / submit
#   2) 验证器     VERIFIER_PRIVATE_KEY        —— 8183 evaluator：complete / reject
#                                                （独立进程持有；也是 SA 的 EIP-712 签名者）
#   3) 客户钱包   MARKETPLACE_PRIVATE_KEY     —— 8183 client：createJob / approve+fund / claimRefund
#                                                （L4 演示 agent 持有，模拟客户侧）
#   4) 采购钱包   PROCUREMENT_PRIVATE_KEY     —— 链下 x402 付款，不参与 8183
#                                                （per-case，需提前 Gateway 预存）
#   5) Module 认证 MODULE_ATTESTER_PRIVATE_KEY —— 离线签 Module 版本认证清单的演示密钥
#                                                （只用于 scripts 离线签名，运行时进程不持有）
#   6) OpenAI     OPENAI_API_KEY              —— 判定器；该进程不持有任何链上私钥
# 角色映射详见 docs/design/contracts-vertical-slice.md §2.1。
# 只用 testnet，无真实资金。

# ── Arc Testnet ────────────────────────────────────────────────────────────
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
# 公共 RPC 易限流，失败时自动切换到备用
ARC_RPC_URL_FALLBACK=https://arc-testnet.drpc.org

# 链上密钥（0x 开头的 32 字节十六进制）
OPERATOR_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=
MARKETPLACE_PRIVATE_KEY=
PROCUREMENT_PRIVATE_KEY=

# 离线签名用，不进运行时进程
MODULE_ATTESTER_PRIVATE_KEY=

# 出口 4（解释性 gray）的 Review Job 专家钱包 —— 接单评审、收酬金的一方。
# 它是 Review Job 的 8183 `provider`，**必须与我方五把钥物理分离**：
# 用运营钱包等于「Citely 自己评审自己」，评审的独立性就没了。
# Review Job 的 `evaluator` 复用 VERIFIER_PRIVATE_KEY（同一个验证器既验 SA 也裁定评审）；
# `client` 是 MARKETPLACE_PRIVATE_KEY——专家的钱永远来自委托人，不来自 Citely。
REVIEW_EXPERT_PRIVATE_KEY=

# ERC-8183 参考合约地址（spike ① 确认可用/部署后回填）
JOB_CONTRACT_ADDRESS=
# Arc Testnet USDC（8183 的 paymentToken，fund 前 approve 用）
USDC_ADDRESS=
# Circle Gateway Wallet（EIP-3009 的 verifyingContract，不是 USDC 合约）
GATEWAY_WALLET_ADDRESS=0x0077777d7eba4688bdef3e311b846f25870a19b9

# 轮询不订阅：链上状态轮询间隔
CHAIN_POLL_INTERVAL_MS=5000

# ── L1 Module 服务（msb-agent，已上线，只消费）─────────────────────────────
MSB_AGENT_BASE_URL=https://msb-agent-production-769d.up.railway.app
X402_FACILITATOR_URL=https://gateway-api-testnet.circle.com/v1/x402

# ── 判定器 LLM（设计见 docs/design/llm-provider-openai.md §5）──────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=
# 留空使用 SDK 默认端点
OPENAI_BASE_URL=
# 必须是带日期的 snapshot ID，**不许用别名**（别名漂移 = golden cache 静默失效）。
# 【已实测 2026-07-30】GET /v1/models 在本 key 下的结果：
#   gpt-5.6-luna / sol / terra —— **只有别名，没有任何带日期 snapshot**，故不可用；
#   可用的带日期 snapshot：gpt-5.4-mini-2026-03-17（主选）、gpt-5.4-2026-03-05、
#   gpt-5.4-nano-2026-03-17、gpt-5.4-pro-2026-03-05、gpt-4.1-*-2025-04-14。
# gpt-5.4-mini-2026-03-17 实测四种参数组合全过（含 effort=none + temperature=0），
# 三种 gray_type schema 写法（W1/W2/W3）也全过。设计 §2.3 的回退梯队第一档。
# ⚠️ 改这个值会让 golden cache 全量失效（模型指纹进 cache key），必须重录 golden。
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_REASONING_EFFORT=none
OPENAI_TEMPERATURE=0

# cache_first | cache_only | live；演示脚本固定用 cache_only
ADJUDICATOR_MODE=cache_first
ADJUDICATOR_TIMEOUT_MS=30000
ADJUDICATOR_MAX_CONCURRENCY=2
GOLDEN_DIR=demo/golden/adjudication
# 1 = golden 文件存材料明文（仅限已审阅的合成案件，会入 git 并被录屏）
GOLDEN_STORE_PLAINTEXT=0

# ── 本地状态（唯一真相源）──────────────────────────────────────────────────
DB_PATH=./data/deal-desk.sqlite

# ══════════════════════════════════════════════════════════════════════════
# 服务化（Railway 部署 + ERC-8004 注册）—— 以下为 Deal Desk 作为「卖方」新增
# ══════════════════════════════════════════════════════════════════════════

# ── HTTP 服务 ──────────────────────────────────────────────────────────────
# Railway 会自动注入 PORT，本地不填则用默认端口
PORT=
# 服务的公开基址。**部署拿到域名后回填**；本地留空自动按 PORT 推导
PUBLIC_BASE_URL=
# 案件状态库路径（与演示用的 DB_PATH 分开，服务侧独立）
CITELY_DB_PATH=

# ── x402 卖方（Deal Desk 收费）────────────────────────────────────────────
# off | x402-arc-testnet（默认 x402-arc-testnet）。off = 不收费，端点开放
X402_SELL_MODE=x402-arc-testnet
# **卖出判定的 USDC 收款地址**。建议用运营钱包地址（8183 provider 侧、SA 签名者，
# 对外身份一致）。注意这里填的是**地址不是私钥**
X402_SELL_PAY_TO=
# 单次判定定价（USDC，最多 6 位小数）
X402_SELL_PRICE_USDC=

# ── 采购侧参数（买 msb-agent 的证据）──────────────────────────────────────
# 默认 us-msb
MODULE_ID=us-msb
# 单个 module 的单价上限（超过即拒绝采购，采购三约束之一）
MODULE_PRICE_USDC=
# 单个案件的采购预算上限（采购三约束之一）
CASE_BUDGET_USDC=

# ── 验证器（Railway 上的第二个服务）───────────────────────────────────────
# remote | in-process。**生产用 remote**——验证器独立部署、只持有自己那把钥匙；
# in-process 仅供本地联调，它意味着同一进程持有全部密钥，会破坏"独立进程独立密钥"
VERIFIER_MODE=remote
# 验证器服务的公开地址（remote 模式必填，部署后回填）
VERIFIER_URL=
# 验证器钱包地址（主服务用它校验回执来源；**地址不是私钥**）
VERIFIER_ADDRESS=
# 🔑 主服务 ↔ 验证器服务之间的共享令牌。**这是密钥**，Railway 上用 secret
INTERNAL_SERVICE_TOKEN=

# ── ERC-8004 注册 ─────────────────────────────────────────────────────────
#
# 下面三项**都是公开信息，不是密钥**：注册表地址、card 的公网 URL、以及链上分配
# 的 agent ID——任何人查一下注册表就能看到，所以这里直接写实际值。
#
# 为什么写死而不留空：这三个值只活在 Railway 的环境变量里时，重建服务就会漏，
# 而漏掉的后果是**静默的**——服务照常起、card 照常返回 200，只是不再声明自己的
# 链上身份（`registrations` 字段消失、`/.well-known/agent-registration.json`
# 退回 404）。没有任何报错会告诉你这件事，我们就真的这样漏过一次。
#
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
# agent card 的公开 URI。**部署拿到域名后回填**，注册脚本会先 GET 校验可达再上链。
# 当前生产部署（Railway 服务 citely-dealdesk-agent）：
AGENT_CARD_URL=https://citely-deal-desk-production.up.railway.app/.well-known/agent-card.json
# 注册成功后回填（脚本会打印），verify-8004 用它复核。
# 当前生产 agent：854638（注册 tx 0x6385f21b…，owner 0x45698638CFF60B188E338aa580e11ba9eb560759）
#
# ⚠️ 与 AGENT_CARD_URL **必须成对**：链上 tokenURI(854638) 就等于上面那个 URL。
# 换域名只改 AGENT_CARD_URL 而不在链上 setAgentURI，card 与链上就对不上了；
# 反过来注册了新 agent 却不改这里，verify-8004 会核对到旧的那个。
ERC8004_AGENT_ID=854638
# 判定用的 rubric 文件路径（服务不替你猜用哪份）。**建议填绝对路径**——
# 相对路径按进程 cwd 解析，Railway 与本地的 cwd 不同会找不到文件
RUBRIC_PATH=
