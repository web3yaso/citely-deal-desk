    "input_schema_url": "/modules/uk-msb/schema"
  },
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "deal_id": {
        "type": "string",
        "minLength": 1
      },
      "parties": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": [
                "payer",
                "payee"
              ]
            },
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "state": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "role",
            "country"
          ],
          "additionalProperties": false
        }
      },
      "activity": {
        "type": "string",
        "enum": [
          "money_transmission",
          "currency_exchange",
          "stored_value",
          "crypto_transfer",
          "check_cashing"
        ]
      },
      "amount_usdc": {
        "type": "number",
        "minimum": 0
      },
      "monthly_volume_usdc": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "evidence": {
        "type": "object",
        "properties": {
          "fca_emoney_authorisation_or_registration": {},
          "fca_payment_institution_authorisation_or_registration": {},
          "hmrc_aml_registration_or_fca_supervision": {},
          "uk_aml_policies_and_controls": {},
          "uk_sar_monitoring_and_reporting_controls": {}
        },
        "additionalProperties": {}
      }
    },
    "required": [
      "deal_id",
      "parties",
      "activity",
      "amount_usdc",
      "evidence"
    ],
    "additionalProperties": false,
    "disclaimer": "本 Module 为基于公开法源整理的 Demo 版本，输出为检查项状态，不构成法律意见。"
  }
}
