{
  "name": "@citely/verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing/sa-fixture.ts",
      "default": "./src/testing/sa-fixture.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "snapshot:modules": "node --import tsx scripts/snapshot-module-rules.ts",
    "sign:attestations": "node --import tsx scripts/sign-attestations.ts"
  },
  "dependencies": {
    "@citely/chain": "workspace:*",
    "@citely/engine": "workspace:*",
    "viem": "^2.55.0"
  }
}
